+        // A backslash escapes a space outside quotes, and " and \ inside double quotes.
+        assert_eq!(split_args("--name My\\ World"), ["--name", "My World"]);
+        assert_eq!(split_args("a\\tb c"), ["atb", "c"]);
+        assert_eq!(split_args("\"a\\\"b\" 'c\\d'"), ["a\"b", "c\\d"]);
+    }
