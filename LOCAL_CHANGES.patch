-                KindArg::Datapack => Kind::DataPack,
-            };
-            let query = Query {
-                everything,
-                ..Query::new(&text.join(" "), kind)
-            };
-            let found = source.get()?.search(&query)?;
-            let datapack = kind == Kind::DataPack;
-            if as_json {
-                json(found.iter().map(|p| {
-                    let support = p.support();
-                    serde_json::json!({
