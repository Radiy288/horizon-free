+    std::env::set_var(
+        "HORIZON_MSA_CLIENT_ID",
+        "00000000-1111-2222-3333-444444444444",
+    );
+    assert_eq!(
+        client_id().as_deref(),
+        Some("00000000-1111-2222-3333-444444444444")
+    );
+    std::env::remove_var("HORIZON_MSA_CLIENT_ID");
+}
