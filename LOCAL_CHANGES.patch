-        tar::Archive::new(flate2::read::GzDecoder::new(file))
-            .unpack(to)
-            .map_err(|e| e.to_string())
-    } else {
-        zip::ZipArchive::new(file)
-            .and_then(|mut z| z.extract(to))
-            .map_err(|e| e.to_string())
-    }
-}
