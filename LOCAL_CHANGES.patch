+        minecraft_expires_at: 0,
+        ..kept
+    };
+    assert!(matches!(
+        check(&ep, Some("test-client"), &notch(), revoked),
+        Check::NoAnswer(e, s) if e == SIGN_IN_AGAIN && s.owns
+    ));
