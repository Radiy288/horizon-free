+fn release_json(r: &Release) -> serde_json::Value {
+    serde_json::json!({
+        "tag": r.tag, "name": r.name, "date": r.date, "prerelease": r.prerelease,
+        "available_here": r.asset.is_some(), "installed": backend::installed().contains(&r.tag),
+    })
+}
